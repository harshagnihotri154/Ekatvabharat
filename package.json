{
  "name": "ekatvabharat-foundation-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "db:migrate": "node --experimental-sqlite --env-file-if-exists=.env scripts/migrate-sqlite.mjs",
    "db:local": "node scripts/local-mongo.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "deploy:connect-api": "node scripts/connect-api.mjs",
    "test:uat": "node scripts/uat.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.344.0",
    "mongodb": "^6.22.0",
    "nodemailer": "^10.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "smtp-server": "^3.21.6",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
